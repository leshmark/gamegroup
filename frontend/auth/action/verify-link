<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Authentication Link &ndash; Game Group</title>
    <link rel="stylesheet" href="/main.css">
    <style>
        .verify-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 80vh;
            padding: 2rem;
        }
        .verify-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 2.5rem 3rem;
            max-width: 480px;
            width: 100%;
            text-align: center;
        }
        .verify-card__brand {
            color: #2c3e50;
            font-size: 2rem;
            font-weight: bold;
            margin: 0 0 0.25rem 0;
        }
        .verify-card__subtitle {
            color: #7f8c8d;
            font-size: 1rem;
            margin: 0 0 2rem 0;
        }
        .status-steps {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            text-align: left;
        }
        .status-step {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.9rem 1.1rem;
            border-radius: 6px;
            font-size: 1rem;
            line-height: 1.4;
        }
        .status-step.active {
            background: #e8f4fd;
            color: #1a5276;
            border-left: 4px solid #3498db;
        }
        .status-step.success {
            background: #d4edda;
            color: #155724;
            border-left: 4px solid #27ae60;
        }
        .status-step.error {
            background: #f8d7da;
            color: #721c24;
            border-left: 4px solid #e74c3c;
        }
        .status-step.info {
            background: #f8f9fa;
            color: #555;
            border-left: 4px solid #95a5a6;
        }
        .status-icon {
            font-size: 1.25rem;
            flex-shrink: 0;
            width: 1.5rem;
            text-align: center;
        }
        .spinner {
            width: 1.1rem;
            height: 1.1rem;
            border: 2px solid #3498db;
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            flex-shrink: 0;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        @media (max-width: 576px) {
            .verify-card {
                padding: 2rem 1.25rem;
            }
            .verify-card__brand {
                font-size: 1.6rem;
            }
        }
    </style>
    <script>
        window.CONFIG = {
            BASE_URL: window.location.origin
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/brython@3.12.0/brython.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/brython@3.12.0/brython_stdlib.js"></script>
</head>
<body onload="brython()">
    <div class="verify-wrapper">
        <div class="verify-card">
            <h1 class="verify-card__brand">Game Group</h1>
            <p class="verify-card__subtitle">Authentication Link Verification</p>
            <div class="status-steps" id="status-steps">
                <div class="status-step active" id="step-main">
                    <div class="spinner"></div>
                    <span>Verifying your link&hellip;</span>
                </div>
            </div>
        </div>
    </div>
    <script type="text/python">
        from verify_link_handler import VerifyLinkHandler
        handler = VerifyLinkHandler()
    </script>
</body>
</html>