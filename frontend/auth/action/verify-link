<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Authentication Link &ndash; Game Group</title>
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="verify-link.css">
    <script>
        window.CONFIG = {
            BASE_URL: window.location.origin
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/brython@3.12.0/brython.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/brython@3.12.0/brython_stdlib.js"></script>
</head>
<body onload="brython()">
    <div class="verify-wrapper">
        <div class="verify-card">
            <h1 class="verify-card__brand">Game Group</h1>
            <p class="verify-card__subtitle">Authentication Link Verification</p>
            <div class="status-steps" id="status-steps">
                <div class="status-step active" id="step-main">
                    <div class="spinner"></div>
                    <span>Verifying your link&hellip;</span>
                </div>
            </div>
            <div id="pin-setup-section" style="display:none;" class="pin-setup-section">
                <hr class="pin-divider">
                <p class="pin-setup-prompt">Set a PIN as a backup login method in case you can&rsquo;t receive email.</p>
                <form id="pin-setup-form" class="pin-setup-form">
                    <div class="form-group">
                        <label for="pin-new">PIN (4&ndash;8 digits):</label>
                        <input type="password" id="pin-new" required placeholder="••••" inputmode="numeric" pattern="\d{4,8}" maxlength="8">
                    </div>
                    <div class="form-group">
                        <label for="pin-confirm">Confirm PIN:</label>
                        <input type="password" id="pin-confirm" required placeholder="••••" inputmode="numeric" pattern="\d{4,8}" maxlength="8">
                    </div>
                    <div class="pin-setup-buttons">
                        <button type="submit" class="submit-btn pin-submit-btn">Set PIN</button>
                        <button type="button" id="pin-skip-btn" class="skip-btn">Skip</button>
                    </div>
                </form>
                <div id="pin-setup-message" class="message"></div>
            </div>
        </div>
    </div>
    <script type="text/python">
        from verify_link_handler import VerifyLinkHandler
        handler = VerifyLinkHandler()
    </script>
</body>
</html>