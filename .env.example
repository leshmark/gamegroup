ENVIRONMENT=example
# Forward Email API credentials
FORWARD_EMAIL_USER=forward_email_username
FORWARD_EMAIL_PASSWORD=forward_email_api_key

# Email settings
FROM_EMAIL=noreply@example.com

# Database settings
DB_HOST=postgres
DB_NAME=gamegroup
DB_USER=username
DB_PASSWORD=password
DB_PORT=5432
EXTERNAL_DB_PORT=5434

# Application settings
BASE_URL=http://localhost:8080
JWT_PRIVATE_KEY=00000000-0000-0000-0000-000000000000
CERT_PATH=./certs.example
LOG_LEVEL=DEBUG

# Docker internal networking (frontend nginx -> backend)
BACKEND_PORT=8000
BACKEND_URL=http://localhost:$(BACKEND_PORT)

# Frontend nginx configuration
HTTP_PORT=8082
HTTPS_PORT=8443
SERVER_NAME=localhost your-domain.example.com

# TLS Certificate settings
DOMAIN=example.com
EMAIL=admin@example.com

# CORS Configuration - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# FlareSolverr - Cloudflare challenge solver used by the BGG scraper.
# Set FLARESOLVERR_ENABLED=false to disable and fetch BGG pages directly.
FLARESOLVERR_ENABLED=true
FLARESOLVERR_URL=http://flaresolverr:8191/v1
FLARESOLVERR_TIMEOUT=90
FLARESOLVERR_MAX_TIMEOUT=60000
FLARESOLVERR_LOG_LEVEL=info
