# Forward Email API credentials
FORWARD_EMAIL_USER=forward_email_username
FORWARD_EMAIL_PASSWORD=forward_email_api_key

# Email settings
FROM_EMAIL=noreply@example.com

# Database settings
DB_HOST=postgres
DB_NAME=gamegroup
DB_USER=username
DB_PASSWORD=password
DB_PORT=5432

# Application settings
BASE_URL=http://localhost:8080
JWT_PRIVATE_KEY=00000000-0000-0000-0000-000000000000
LOG_LEVEL=DEBUG

# Docker internal networking (frontend nginx -> backend)
BACKEND_URL=http://backend:8000

# Frontend nginx configuration
HTTP_PORT=8082
HTTPS_PORT=8443
SERVER_NAME=localhost your-domain.example.com

# TLS Certificate settings
DOMAIN=example.com
EMAIL=admin@example.com

# GCP Configuration
GCP_ACCOUNT=user@example.com
GCP_PROJECT_ID=my-project-id
GCP_REGION=us-central1
FRONTEND_DOMAIN_NAME=gamegroup.example.com
BACKEND_DOMAIN_NAME=gamegroup-api.example.com
FRONTEND_IMAGE=frontend
BACKEND_IMAGE=backend

# CORS Configuration - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080